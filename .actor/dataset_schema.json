{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "input": {
                "type": "object",
                "properties": {
                    "url": { "type": "string" }
                }
            },
            "scrape": {
                "type": "object",
                "properties": {
                    "jobId": { "type": "string" },
                    "status": { "type": "string" },
                    "scrapedAt": { "type": "string" },
                    "browserMode": { "type": "string" },
                    "error": { "type": "string" }
                }
            },
            "completeness": {
                "type": "object",
                "properties": {
                    "allCommentsFilterApplied": { "type": "boolean" },
                    "commentsExtracted": { "type": "boolean" },
                    "postReactionsExtracted": { "type": "boolean" }
                }
            },
            "post": {
                "type": "object",
                "properties": {
                    "url": { "type": "string" },
                    "reactionSummary": {
                        "type": "object",
                        "properties": {
                            "total": { "type": "number" }
                        }
                    },
                    "reactions": { "type": "array" }
                }
            },
            "comments": {
                "type": "array"
            },
            "artifacts": {
                "type": "object",
                "properties": {
                    "video": {
                        "type": "object",
                        "properties": {
                            "present": { "type": "boolean" },
                            "key": { "type": "string" },
                            "contentType": { "type": "string" },
                            "localPath": { "type": "string" }
                        }
                    }
                }
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "scrape.jobId",
                    "input.url",
                    "scrape.status",
                    "scrape.scrapedAt",
                    "post.url",
                    "post.reactionSummary.total",
                    "completeness.allCommentsFilterApplied",
                    "artifacts.video.key"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "scrape.jobId": {
                        "label": "Job ID",
                        "format": "text"
                    },
                    "input.url": {
                        "label": "Input URL",
                        "format": "link"
                    },
                    "scrape.status": {
                        "label": "Status",
                        "format": "text"
                    },
                    "scrape.scrapedAt": {
                        "label": "Scraped At",
                        "format": "date"
                    },
                    "post.url": {
                        "label": "Final Post URL",
                        "format": "link"
                    },
                    "post.reactionSummary.total": {
                        "label": "Post Reactions",
                        "format": "number"
                    },
                    "completeness.allCommentsFilterApplied": {
                        "label": "All Comments Filter",
                        "format": "boolean"
                    },
                    "artifacts.video.key": {
                        "label": "Video Key",
                        "format": "text"
                    }
                }
            }
        }
    }
}
